{
  "name": "repro",
  "version": "0.1.0",
  "description": "REPRO: open-source emulator hub",
  "main": "src/main/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "brand": "electron test/brandshot.js && python scripts/make-ico.py",
    "shot": "electron test/couchshot.js",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run icon && electron-builder --win portable"
  },
  "build": {
    "appId": "io.repro.hub",
    "productName": "REPRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "themes/**/*",
      "recipes/**/*",
      "systems.json",
      "package.json",
      "!node_modules/**",
      "!saves/**",
      "!library.json",
      "!config.json",
      "!art/**",
      "!dist/**",
      "!sketches/**",
      "!test/**",
      "!docs/**"
    ],
    "win": {
      "icon": "assets/brand/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.1.1": true,
    "electron-winstaller@5.4.0": true,
    "koffi@2.16.3": true
  },
  "dependencies": {
    "xinput-ffi": "^4.0.2"
  }
}
